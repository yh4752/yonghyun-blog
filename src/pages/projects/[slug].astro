---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectPostList from "../../components/project/ProjectPostList.astro";
import { projects } from "../../data/projects";
import { filterPostsByProject, getPublishedPosts } from "../../utils/posts";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const posts = filterPostsByProject(await getPublishedPosts(), project.slug);
---

<ProjectLayout project={project}>
  <ProjectPostList posts={posts} />
</ProjectLayout>
