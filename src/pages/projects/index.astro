---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import ProjectCard from "../../components/project/ProjectCard.astro";
import { projects } from "../../data/projects";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const projectPostCounts = posts.reduce<Record<string, number>>((counts, post) => {
  counts[post.project] = (counts[post.project] ?? 0) + 1;
  return counts;
}, {});
---

<BaseLayout title="Projects" description="프로젝트 포트폴리오" canonicalPath="/projects">
  <PageHeader eyebrow="Project Archive" title="프로젝트" description="각 프로젝트의 목표, 기술 스택, 개발 기록을 한 곳에서 확인할 수 있게 정리합니다." />
  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} relatedPostCount={projectPostCounts[project.slug] ?? 0} />)}
  </div>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
</style>
