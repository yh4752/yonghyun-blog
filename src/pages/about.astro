---
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilities = [
  {
    label: "Backend",
    value: "Kotlin Spring Boot, Python FastAPI, REST API, JPA, KotlinJDSL, JWT",
  },
  {
    label: "Search / Retrieval",
    value: "Elasticsearch, BM25, nori analyzer, Qdrant, dense vector search, Hybrid Retrieval, RRF",
  },
  {
    label: "RAG / LLM Systems",
    value: "GraphRAG, async LLM pipeline, Pydantic schema validation, SSE token streaming",
  },
  {
    label: "Data / Infra",
    value: "PostgreSQL, Oracle, Neo4j, Airflow, Docker, MinIO, event-driven indexing",
  },
  {
    label: "Frontend",
    value: "React, TypeScript, Vite, Axios, Zod, D3.js",
  },
];

const highlights = [
  "운영 환경에서 Hybrid Retrieval, GraphRAG, Airflow 증분 ETL, 검색 인덱싱 파이프라인을 엔드투엔드로 설계하고 구현했습니다.",
  "PostgreSQL 같은 source of truth와 Elasticsearch/Qdrant 같은 projection store를 분리해, 검색 인프라 장애가 핵심 데이터 경로로 전파되지 않도록 설계합니다.",
  "짧은 한국어 다의어 query에서 semantic mismatch와 retrieval failure를 경험했고, 이를 검색 신뢰도 평가 문제로 확장해 탐구하고 있습니다.",
];

const projects = [
  {
    name: "Sigak",
    href: "/projects/sigak",
    meta: "AI 기술 뉴스 Search/RAG Reliability Platform",
    body: "AI·소프트웨어 기술 뉴스를 수집하고, 검색·요약·관련 개념 탐색을 제공하는 공개 포트폴리오 프로젝트입니다. 검색 projection, RAG 실험, DB 문서화, 평가 흐름을 계속 쌓고 있습니다.",
  },
  {
    name: "Yonghyun Blog",
    href: "/projects/yonghyun-blog",
    meta: "Search/RAG/Architecture Technical Archive",
    body: "결과물만 나열하지 않고, 왜 그 설계를 선택했는지와 어떤 검증을 했는지를 dev-log와 deep-dive로 남기는 기술 아카이브입니다.",
  },
];

const links = [
  { label: "Email", href: "mailto:yh47529722@gmail.com", value: "yh47529722@gmail.com" },
  { label: "GitHub", href: "https://github.com/yh4752", value: "github.com/yh4752" },
  { label: "LinkedIn", href: "https://linkedin.com/in/yh4752", value: "linkedin.com/in/yh4752" },
];
---

<BaseLayout
  title="About"
  description="AI Backend, Search/RAG, Retrieval Reliability에 집중하는 Yonghyun의 소개"
  canonicalPath="/about"
>
  <section class="about-hero" aria-labelledby="about-title">
    <p class="eyebrow">About · Profile</p>
    <h1 id="about-title">Search/RAG 시스템의 실패 지점을 추적하고, 백엔드 구조로 검증 가능한 흐름을 만듭니다.</h1>
    <p class="lead">
      AI Backend Engineer 지망으로, 검색이 단순히 동작하는 것을 넘어 결과를 신뢰할 수 있는지
      평가하고 개선하는 시스템에 관심이 있습니다.
    </p>
  </section>

  <section class="about-grid" aria-label="Profile summary">
    <div class="intro">
      <p>
        군 복무 중 운영 환경에서 Hybrid Retrieval, GraphRAG, Airflow 기반 증분 ETL, RDB와 검색/벡터
        저장소 동기화 구조를 설계하고 구현했습니다. 지금은 Sigak과 Yonghyun Blog를 통해 Search/RAG
        Reliability, source of truth와 projection store 분리, 검증 가능한 발행 흐름을 공개 기록으로
        확장하고 있습니다.
      </p>
      <p>
        장기적으로는 Hybrid Retrieval의 failure case, 한국어 semantic mismatch, uncertainty-aware RAG,
        anomaly detection 기반 검색 신뢰도 평가를 연구와 제품 경험 사이에서 연결하고 싶습니다.
      </p>
    </div>

    <dl class="quick-facts">
      <div>
        <dt>Role</dt>
        <dd>AI Backend Engineer · Search/RAG Systems Engineer</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Search/RAG Reliability · Hybrid Retrieval · Backend Architecture</dd>
      </div>
      <div>
        <dt>Research</dt>
        <dd>IDEAL Lab URP 예정 · retrieval failure detection · semantic mismatch</dd>
      </div>
      <div>
        <dt>Language</dt>
        <dd>한국어 · English working proficiency · 일본어 JLPT N2 학습 중</dd>
      </div>
    </dl>
  </section>

  <section class="section-block" aria-labelledby="work-title">
    <p class="section-label">How I Work</p>
    <h2 id="work-title">관심사는 검색 품질이고, 강점은 끝까지 추적하는 구현입니다.</h2>
    <div class="highlight-list">
      {highlights.map((item) => <p>{item}</p>)}
    </div>
  </section>

  <section class="section-block" aria-labelledby="stack-title">
    <p class="section-label">Stack</p>
    <h2 id="stack-title">주로 다루는 기술</h2>
    <div class="capability-list">
      {
        capabilities.map((capability) => (
          <div>
            <h3>{capability.label}</h3>
            <p>{capability.value}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-block" aria-labelledby="projects-title">
    <p class="section-label">Current Projects</p>
    <h2 id="projects-title">지금 공개적으로 쌓고 있는 것</h2>
    <div class="project-list">
      {
        projects.map((project) => (
          <article>
            <p>{project.meta}</p>
            <h3><a href={project.href}>{project.name}</a></h3>
            <span>{project.body}</span>
            <a class="text-link" href={project.href}>Open folder -&gt;</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-block contact-block" aria-labelledby="contact-title">
    <div>
      <p class="section-label">Contact</p>
      <h2 id="contact-title">연락과 기록</h2>
      <p>
        채용, 협업, 프로젝트 피드백은 아래 링크로 연락할 수 있습니다. 이 블로그에는 구현 결과보다
        설계 판단과 검증 과정을 더 많이 남기려 합니다.
      </p>
    </div>
    <ul>
      {
        links.map((link) => (
          <li>
            <span>{link.label}</span>
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
              {link.value}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .about-hero {
    max-width: 940px;
    padding: 70px 0 42px;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow,
  .section-label {
    margin: 0;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: 900px;
    margin: 14px 0 0;
    font-size: 64px;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .lead {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 19px;
    line-height: 1.8;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
    gap: 42px;
    padding: 42px 0 26px;
  }

  .intro {
    display: grid;
    gap: 16px;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.85;
  }

  .intro p,
  .highlight-list p,
  .contact-block p,
  .capability-list p,
  .project-list p,
  .project-list span {
    margin: 0;
  }

  .quick-facts {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .quick-facts div,
  .capability-list div {
    display: grid;
    gap: 8px;
    border-top: 1px solid var(--color-border);
    padding: 18px 0;
  }

  .quick-facts dt,
  .contact-block li span {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .quick-facts dd {
    margin: 0;
    line-height: 1.7;
  }

  .section-block {
    padding: 52px 0 0;
  }

  .section-block h2 {
    max-width: 760px;
    margin: 12px 0 24px;
    font-size: 42px;
    line-height: 1.22;
    letter-spacing: 0;
  }

  .highlight-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .highlight-list p,
  .project-list article {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-object);
    background: var(--color-surface);
    box-shadow: var(--shadow-rest);
    padding: 22px;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .capability-list {
    display: grid;
    gap: 0;
  }

  .capability-list div {
    grid-template-columns: 210px 1fr;
    align-items: baseline;
  }

  .capability-list h3,
  .project-list h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .capability-list p,
  .project-list span,
  .contact-block p {
    color: var(--color-muted);
    line-height: 1.75;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .project-list article {
    display: grid;
    gap: 12px;
  }

  .project-list article::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 22px;
    width: 92px;
    height: 10px;
    border: 1px solid var(--color-border);
    border-bottom: 0;
    border-radius: 5px 5px 0 0;
    background: var(--color-surface);
  }

  .project-list p {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-list h3 a {
    text-decoration: none;
  }

  .text-link {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
  }

  .contact-block {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(280px, 1fr);
    gap: 42px;
    padding-bottom: 80px;
  }

  .contact-block ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-block li {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 18px;
    border-top: 1px solid var(--color-border);
    padding: 16px 0;
  }

  .contact-block a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .about-hero {
      padding-top: 42px;
    }

    .about-hero h1 {
      font-size: 46px;
    }

    .section-block h2 {
      font-size: 34px;
    }

    .about-grid,
    .contact-block,
    .highlight-list,
    .project-list {
      grid-template-columns: 1fr;
    }

    .capability-list div {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .about-hero h1 {
      font-size: 32px;
    }

    .section-block h2 {
      font-size: 28px;
    }

    .lead,
    .intro {
      font-size: 15.5px;
    }

    .section-block {
      padding-top: 42px;
    }

    .contact-block li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
