---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/blog/PostList.astro";
import { filterPostsByType, getPublishedPosts } from "../../utils/posts";

const posts = filterPostsByType(await getPublishedPosts(), "deep-dive");
---

<BaseLayout title="기술 딥다이브" description="스택 선택과 설계 판단을 깊게 정리한 글" canonicalPath="/blog/deep-dive">
  <section class="page-header">
    <p>Deep Dives</p>
    <h1>기술 딥다이브</h1>
    <span>왜 그 스택과 모델을 선택했는지, 무엇을 검증했는지 기록합니다.</span>
  </section>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .page-header {
    max-width: 760px;
    padding: 64px 0 28px;
  }

  .page-header p {
    margin: 0 0 10px;
    color: var(--color-positive);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .page-header span {
    display: block;
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
  }
</style>
