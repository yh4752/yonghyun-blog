---
import { render } from "astro:content";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import { getPublishedPosts, getRelatedPosts } from "../../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: {
      project: post.project,
      slug: post.slug,
    },
    props: {
      post,
      previous: posts[index + 1],
      next: posts[index - 1],
      relatedPosts: getRelatedPosts(posts, post),
    },
  }));
}

const { post, previous, next, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} Content={Content} headings={headings} previous={previous} next={next} relatedPosts={relatedPosts} />
