---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/blog/PostList.astro";
import { filterPostsByType, getPublishedPosts } from "../../utils/posts";

const posts = filterPostsByType(await getPublishedPosts(), "dev-log");
---

<BaseLayout title="개발 로그" description="매일의 구현 흐름과 다음 단계를 정리한 개발 로그" canonicalPath="/blog/dev-log">
  <section class="page-header">
    <p>Development Log</p>
    <h1>개발 로그</h1>
    <span>하루 단위로 무엇을 만들었고 어떤 판단을 남겼는지 정리합니다.</span>
  </section>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .page-header {
    max-width: 760px;
    padding: 64px 0 30px;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header p {
    margin: 0 0 10px;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .page-header span {
    display: block;
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
  }
</style>
