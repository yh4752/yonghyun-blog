---
import PostList from "../blog/PostList.astro";
import type { BlogPost } from "../../utils/posts";

type Props = {
  posts: BlogPost[];
  projectName?: string;
};

const { posts, projectName = "이 프로젝트" } = Astro.props;
---

<section class="project-posts" aria-labelledby="project-posts-title">
  <h2 id="project-posts-title">관련 글</h2>
  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <div class="empty-state" role="status">
        <p>{projectName} 프로젝트에 공개된 글이 아직 없습니다.</p>
        <span>새 글이 동기화되면 이곳에 최신순으로 표시됩니다.</span>
      </div>
    )
  }
</section>

<style>
  .project-posts {
    margin-top: 48px;
  }

  .project-posts h2 {
    margin: 0 0 12px;
    font-size: 22px;
    letter-spacing: 0;
  }

  .empty-state {
    margin-top: 16px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 20px;
    background: var(--color-surface);
  }

  .empty-state p {
    margin: 0;
    color: var(--color-text);
    font-size: 17px;
    font-weight: 600;
  }

  .empty-state span {
    display: block;
    margin-top: 6px;
    color: var(--color-muted);
    line-height: 1.6;
  }
</style>
