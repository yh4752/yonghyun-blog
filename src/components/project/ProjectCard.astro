---
import type { Project } from "../../data/projects";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="project-card">
  <p>{project.status}</p>
  <h2><a href={`/projects/${project.slug}`}>{project.name}</a></h2>
  <span>{project.description}</span>
  <ul aria-label={`${project.name} stack`}>
    {project.stack.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .project-card {
    display: grid;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .project-card p,
  .project-card span {
    margin: 0;
    color: var(--color-muted);
  }

  .project-card h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: 0;
  }

  .project-card h2 a {
    text-decoration: none;
  }

  .project-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card li {
    border-radius: 999px;
    background: var(--color-code-bg);
    padding: 4px 9px;
    color: var(--color-muted);
    font-size: 12px;
  }
</style>
