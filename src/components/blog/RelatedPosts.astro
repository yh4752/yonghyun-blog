---
import type { BlogPost } from "../../utils/posts";
import { formatDate } from "../../utils/dates";

type Props = {
  posts: BlogPost[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="related-posts" aria-labelledby="related-posts-title">
      <div class="section-heading">
        <p>Continue reading</p>
        <h2 id="related-posts-title">관련 글</h2>
      </div>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={post.href}>
              <span>{formatDate(post.data.date)} · {post.project}</span>
              <strong>{post.data.title}</strong>
              <p>{post.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-posts {
    max-width: 820px;
    margin-top: 48px;
    border-top: 1px solid var(--color-border);
    padding-top: 28px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .section-heading p {
    margin: 0;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 22px;
    letter-spacing: 0;
  }

  ul {
    display: grid;
    gap: 0;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-top: 1px solid var(--color-border);
  }

  a {
    display: grid;
    gap: 5px;
    padding: 16px 0;
    text-decoration: none;
  }

  a:hover strong,
  a:focus-visible strong {
    color: var(--color-accent-strong);
  }

  span {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  strong {
    font-size: 17px;
    line-height: 1.45;
  }

  a p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.65;
  }
</style>
