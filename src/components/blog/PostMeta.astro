---
import { formatDate } from "../../utils/dates";

type Props = {
  date: Date;
  project: string;
  type: string;
};

const { date, project, type } = Astro.props;
---

<p class="post-meta">
  <span>{formatDate(date)}</span>
  <span>{project}</span>
  <span>{type}</span>
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .post-meta span + span::before {
    content: "/";
    margin-right: 12px;
    color: var(--color-border);
  }
</style>
