---
import type { BlogPost } from "../../utils/posts";
import { formatDate } from "../../utils/dates";

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
---

<article class="post-card">
  <div class="date-column">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{post.data.type}</span>
  </div>
  <div class="post-body">
    <h2><a href={post.href}>{post.data.title}</a></h2>
    <p>{post.data.summary}</p>
    <div class="meta-row">
      <span class="project">{post.project}</span>
      <span class="separator">/</span>
      <ul class="tags" aria-label="태그">
        {post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 28px;
    position: relative;
    padding: 20px 14px;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.16s ease;
  }

  .post-card::before {
    content: "";
    position: absolute;
    inset: 0 auto -1px 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease;
  }

  .post-card:hover,
  .post-card:focus-within {
    background: color-mix(in srgb, var(--color-accent-soft) 54%, transparent);
  }

  .post-card:hover::before,
  .post-card:focus-within::before {
    transform: scaleY(1);
  }

  .date-column {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-top: 4px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
  }

  .date-column span {
    color: var(--color-faint);
    font-size: 11px;
  }

  .post-body {
    min-width: 0;
  }

  .post-card h2 {
    margin: 0;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .post-card h2 a {
    text-decoration: none;
  }

  .post-card:hover h2 a,
  .post-card:focus-within h2 a {
    color: var(--color-accent-strong);
  }

  .post-card p {
    max-width: 760px;
    margin: 7px 0 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    margin-top: 12px;
  }

  .project {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .separator {
    color: var(--color-faint);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--color-paper);
    padding: 2px 7px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 700px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 18px 4px;
    }

    .date-column {
      display: flex;
      gap: 8px;
      align-items: center;
      padding-top: 0;
    }
  }
</style>
