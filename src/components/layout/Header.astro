---
import SearchPalette from "./SearchPalette.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Yonghyun Blog home">
    <span>Yonghyun</span>
    <small>/ archive</small>
  </a>
  <nav class="nav" aria-label="주요 메뉴">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <SearchPalette />
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 22px;
    align-items: center;
    width: 100%;
    padding: 24px max(22px, calc((100vw - var(--content-width)) / 2)) 22px;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand small {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .nav {
    display: flex;
    gap: 26px;
    align-items: center;
  }

  .nav a {
    position: relative;
    padding-bottom: 3px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
  }

  .nav a::after {
    content: "";
    position: absolute;
    right: 100%;
    bottom: 0;
    left: 0;
    height: 1.5px;
    background: var(--color-accent);
    transition: right 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-text);
  }

  .nav a:hover::after,
  .nav a:focus-visible::after,
  .nav a[aria-current="page"]::after {
    right: 0;
  }

  .nav a[aria-current="page"] {
    color: var(--color-text);
  }

  @media (max-width: 860px) {
    .site-header {
      display: flex;
      gap: 12px;
      justify-content: space-between;
      padding: 20px 22px 16px;
    }

    .brand {
      flex-shrink: 0;
      gap: 9px;
      font-size: 19px;
      white-space: nowrap;
    }

    .brand small {
      display: none;
    }

    .nav {
      gap: 14px;
      margin-left: auto;
    }

    .nav a {
      font-size: 11.5px;
    }
  }

  @media (max-width: 420px) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 12px;
    }

    .nav {
      grid-area: 2 / 1 / 3 / -1;
      margin-left: 0;
    }
  }

  @media (max-width: 380px) {
    .site-header {
      padding-right: 18px;
      padding-left: 18px;
    }

    .nav {
      gap: 10px;
    }

    .nav a {
      font-size: 11px;
    }
  }
</style>
