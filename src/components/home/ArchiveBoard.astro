---
import type { Project } from "../../data/projects";
import type { BlogPost } from "../../utils/posts";
import { formatDate } from "../../utils/dates";

type Props = {
  projects: Project[];
  latestPost?: BlogPost;
  validationPost?: BlogPost;
  projectPostCounts: Record<string, number>;
};

const { projects, latestPost, validationPost, projectPostCounts } = Astro.props;
const sigak = projects.find((project) => project.slug === "sigak") ?? projects[0];
const projectCount = projects.length;
const postCount = Object.values(projectPostCounts).reduce((total, count) => total + count, 0);
const sigakCount = sigak ? projectPostCounts[sigak.slug] ?? 0 : 0;
const latestDate = latestPost ? formatDate(latestPost.data.date) : "";
const validationDate = validationPost ? formatDate(validationPost.data.date) : "";
---

<section class="archive-board" aria-label="Archive quick access">
  <div class="board-label">Archive board</div>

  <a class="folder" href="/projects">
    <span class="object-label">Folder</span>
    <strong>Projects</strong>
    <span>{projectCount} case studies -></span>
  </a>

  <a class="folder" href="/blog">
    <span class="object-label">Folder</span>
    <strong>Blog</strong>
    <span>{postCount} notes & logs -></span>
  </a>

  {
    sigak && (
      <a class="note note-yellow" href={`/projects/${sigak.slug}`}>
        <span class="object-label">Memo · Current</span>
        <strong>{sigak.name}</strong>
        <span>{sigakCount} related notes · in progress</span>
      </a>
    )
  }

  <a class="note note-cyan" href="/about">
    <span class="object-label">Note</span>
    <strong>About me</strong>
    <span>background · resume</span>
  </a>

  {
    latestPost && (
      <a class="slip" href={latestPost.href}>
        <span class="slip-head">
          <span>Latest writing</span>
          <time datetime={latestPost.data.date.toISOString()}>{latestDate}</time>
        </span>
        <strong>{latestPost.data.title}</strong>
        <span>{latestPost.data.summary}</span>
      </a>
    )
  }

  {
    validationPost && (
      <a class="slip" href={validationPost.href}>
        <span class="slip-head">
          <span>Validation log</span>
          <time datetime={validationPost.data.date.toISOString()}>{validationDate}</time>
        </span>
        <strong>{validationPost.data.title}</strong>
      </a>
    )
  }
</section>

<style>
  .archive-board {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .board-label {
    position: absolute;
    top: 12px;
    right: 16px;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .folder,
  .note,
  .slip {
    color: var(--color-text);
    text-decoration: none;
  }

  .folder,
  .note {
    display: grid;
    gap: 7px;
    min-height: 116px;
    padding: 18px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .folder {
    position: relative;
    margin-top: 8px;
    border: 1px solid var(--color-folder-edge);
    border-radius: 7px;
    background: var(--color-folder);
    box-shadow: var(--shadow-soft);
  }

  .folder::before {
    content: "";
    position: absolute;
    top: -9px;
    left: 16px;
    width: 84px;
    height: 11px;
    border: 1px solid var(--color-folder-edge);
    border-bottom: 0;
    border-radius: 5px 5px 0 0;
    background: var(--color-folder);
  }

  .note {
    border: 1px solid transparent;
    border-radius: 4px;
    box-shadow: var(--shadow-object);
  }

  .note-yellow {
    background: var(--color-note-yellow);
  }

  .note-cyan {
    background: var(--color-note-cyan);
  }

  .slip {
    grid-column: 1 / -1;
    display: grid;
    gap: 9px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-paper);
    box-shadow: var(--shadow-soft);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .folder:hover,
  .note:hover,
  .slip:hover,
  .folder:focus-visible,
  .note:focus-visible,
  .slip:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-object);
  }

  .slip:hover,
  .slip:focus-visible {
    border-color: var(--color-border-strong);
  }

  .object-label,
  .slip-head span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .folder strong,
  .note strong,
  .slip strong {
    font-size: 20px;
    line-height: 1.25;
  }

  .folder span:last-child,
  .note span:last-child,
  .slip > span:last-child {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .slip-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .slip-head time {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .archive-board {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 18px;
    }

    .board-label {
      position: static;
      margin-bottom: 2px;
    }

    .folder,
    .note,
    .slip {
      grid-column: auto;
      min-height: 0;
      margin-top: 0;
      padding: 16px;
    }

    .folder::before {
      display: none;
    }
  }
</style>
