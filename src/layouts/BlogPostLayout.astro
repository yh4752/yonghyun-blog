---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import PostMeta from "../components/blog/PostMeta.astro";
import "../styles/prose.css";
import type { BlogPost } from "../utils/posts";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  post: BlogPost;
  Content: any;
  headings: Heading[];
  previous?: BlogPost;
  next?: BlogPost;
};

const { post, Content, headings, previous, next } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.summary} canonicalPath={post.href}>
  <div class="reading-progress" data-reading-progress></div>
  <article class="post-shell">
    <header class="post-header">
      <PostMeta date={post.data.date} project={post.project} type={post.data.type} />
      <h1>{post.data.title}</h1>
      <p>{post.data.summary}</p>
      <ul class="tags" aria-label="태그">
        {post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <button class="copy-link" type="button" data-copy-link>링크 복사</button>
    </header>

    <div class="mobile-toc">
      <TableOfContents headings={headings} />
    </div>

    <div class="post-grid">
      <div class="prose">
        <Content />
      </div>
      <div class="desktop-toc">
        <TableOfContents headings={headings} />
      </div>
    </div>

    <nav class="post-nav" aria-label="이전 다음 글">
      {previous ? <a href={previous.href}>이전 글<span>{previous.data.title}</span></a> : <span></span>}
      {next ? <a href={next.href}>다음 글<span>{next.data.title}</span></a> : <span></span>}
    </nav>
  </article>

  <script>
    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    const updateProgress = () => {
      if (!progress) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? (window.scrollY / max) * 100 : 0;
      progress.style.width = `${Math.min(100, Math.max(0, value))}%`;
    };
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });

    document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async () => {
      const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
      if (!button) return;
      await navigator.clipboard.writeText(window.location.href);
      button.textContent = "복사됨";
      window.setTimeout(() => {
        button.textContent = "링크 복사";
      }, 1400);
    });
  </script>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 20;
    width: 0;
    height: 2px;
    background: var(--color-accent);
  }

  .post-shell {
    padding-top: 42px;
  }

  .post-header {
    display: grid;
    gap: 14px;
    max-width: var(--prose-width);
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .post-header p {
    margin: 0;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 9px;
    color: var(--color-muted);
    font-size: 12px;
  }

  .copy-link {
    width: fit-content;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 7px 12px;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--prose-width)) 220px;
    gap: 64px;
    align-items: start;
    margin-top: 40px;
    min-width: 0;
  }

  .desktop-toc {
    position: sticky;
    top: 24px;
    padding-top: 6px;
  }

  .mobile-toc {
    display: none;
    margin-top: 28px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 16px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: var(--prose-width);
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .post-nav a {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }

  .post-nav a:last-child {
    text-align: right;
  }

  .post-nav span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .desktop-toc {
      display: none;
    }

    .mobile-toc {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav a:last-child {
      text-align: left;
    }
  }
</style>
