---
import type { MarkdownHeading } from "astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import PostMeta from "../components/blog/PostMeta.astro";
import RelatedPosts from "../components/blog/RelatedPosts.astro";
import { site } from "../data/site";
import "../styles/prose.css";
import type { BlogPost } from "../utils/posts";

type Props = {
  post: BlogPost;
  Content: AstroComponentFactory;
  headings: MarkdownHeading[];
  previous?: BlogPost;
  next?: BlogPost;
  relatedPosts: BlogPost[];
};

const { post, Content, headings, previous, next, relatedPosts } = Astro.props;
const postUrl = new URL(post.href, site.siteUrl).toString();
const authorUrl = new URL(site.author.url, site.siteUrl).toString();
const ogImageUrl = new URL(site.defaultOgImage, site.siteUrl).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: site.author.name,
    url: authorUrl,
    sameAs: site.author.sameAs,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  url: postUrl,
  image: ogImageUrl,
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout title={post.data.title} description={post.data.summary} canonicalPath={post.href} ogType="article" jsonLd={jsonLd}>
  <div class="reading-progress" data-reading-progress></div>
  <article class="post-shell" data-pagefind-body>
    <header class="post-header">
      <PostMeta date={post.data.date} project={post.project} type={post.data.type} />
      <div class="pagefind-filters" aria-hidden="true" data-pagefind-ignore>
        <span data-pagefind-filter="project">{post.project}</span>
        <span data-pagefind-filter="type">{post.data.type}</span>
      </div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p>{post.data.summary}</p>
      <div class="post-tools">
        <ul class="tags" aria-label="태그">
          {post.data.tags.map((tag) => <li data-pagefind-filter="tag">{tag}</li>)}
        </ul>
        <button class="copy-link" type="button" data-copy-link>Copy link</button>
      </div>
    </header>

    <div class="mobile-toc">
      <TableOfContents headings={headings} />
    </div>

    <div class="post-grid">
      <div class="prose">
        <Content />
      </div>
      <div class="desktop-toc">
        <TableOfContents headings={headings} />
      </div>
    </div>

    <nav class="post-nav" aria-label="이전 다음 글" data-pagefind-ignore>
      {previous ? <a href={previous.href}>이전 글<span>{previous.data.title}</span></a> : <span></span>}
      {next ? <a href={next.href}>다음 글<span>{next.data.title}</span></a> : <span></span>}
    </nav>

    <div data-pagefind-ignore>
      <RelatedPosts posts={relatedPosts} />
    </div>
  </article>

  <script>
    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    const updateProgress = () => {
      if (!progress) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? (window.scrollY / max) * 100 : 0;
      progress.style.width = `${Math.min(100, Math.max(0, value))}%`;
    };
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });

    document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async () => {
      const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
      if (!button) return;
      await navigator.clipboard.writeText(window.location.href);
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = "Copy link";
      }, 1400);
    });
  </script>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 20;
    width: 0;
    height: 2px;
    background: var(--color-accent);
  }

  .post-shell {
    padding-top: 44px;
  }

  .post-header {
    display: grid;
    gap: 14px;
    max-width: 820px;
  }

  .pagefind-filters {
    display: none;
  }

  .post-header h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.12;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .post-header p {
    margin: 0;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .post-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 4px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    background: var(--color-paper);
    padding: 3px 8px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .copy-link {
    width: fit-content;
    border: 1px solid var(--color-border-strong);
    border-radius: 5px;
    padding: 6px 10px;
    background: var(--color-paper);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .copy-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--prose-width)) 220px;
    gap: 64px;
    align-items: start;
    margin-top: 40px;
    min-width: 0;
  }

  .desktop-toc {
    position: sticky;
    top: 24px;
    padding-top: 6px;
  }

  .mobile-toc {
    display: none;
    margin-top: 28px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: var(--prose-width);
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .post-nav a {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }

  .post-nav a:last-child {
    text-align: right;
  }

  .post-nav span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .desktop-toc {
      display: none;
    }

    .mobile-toc {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav a:last-child {
      text-align: left;
    }
  }
</style>
